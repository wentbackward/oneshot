{
  "base_branch": "main",
  "remote": "origin",
  "fast_check": "",
  "checks": [
    "test -s bricks.html",
    "head -c 15 bricks.html | tr -d '\\0' | grep -qi '<!doctype html>'",
    "grep -q 'requestAnimationFrame' bricks.html",
    "grep -qE 'class=\"game\"|id=\"game\"|<canvas' bricks.html",
    "grep -qi 'monospace' bricks.html",
    "[ \"$(grep -cE '(src|href)=' bricks.html)\" -eq 0 ]",
    "grep -qE '^[[:space:]]*#game[[:space:]]*\\{[^}]*cursor:[[:space:]]*none' bricks.html",
    "[ \"$(grep -c 'data-difficulty=' bricks.html)\" -eq 3 ]",
    "grep -E 'data-difficulty=\"normal\"' bricks.html | grep -q 'selected'",
    "for f in tests/bricks-*.test.mjs; do timeout 60 node \"$f\" || exit 1; done"
  ],
  "heavy": { "slots": 2 },
  "stop_gate": { "require_clean_tree": true, "max_blocks": 5 },
  "merge": { "method": "squash", "delete_branch": true }
}
