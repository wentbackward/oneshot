{
  "base_branch": "main",
  "remote": "origin",
  "fast_check": "",
  "checks": [
    "test -s index.html",
    "head -c 15 index.html | tr -d '\\0' | grep -qi '<!doctype html>'",
    "grep -q 'requestAnimationFrame' index.html",
    "grep -qE 'class=\"game\"|id=\"game\"|<canvas' index.html",
    "grep -q 'THRUST' index.html",
    "grep -q 'FRICTION' index.html",
    "grep -q 'TURN_SPEED' index.html",
    "grep -q 'LASER_COOLDOWN_MS' index.html",
    "grep -q 'ASTEROID_BASE' index.html",
    "grep -q 'ASTEROID_GROWTH' index.html",
    "grep -q 'SCORE_PER_ASTEROID' index.html",
    "grep -q 'PLAYER_MAX_HP' index.html",
    "grep -q 'INVULN_MS' index.html",
    "grep -q 'DRONE_BASE' index.html",
    "grep -q 'DRONE_GROWTH' index.html",
    "grep -q 'BETWEEN_WAVES_S' index.html",
    "grep -q 'SCORE_PER_DRONE' index.html",
    "grep -qi 'monospace' index.html",
    "[ \"$(grep -cE '(src|href)=' index.html)\" -eq 0 ]"
  ],
  "heavy": { "slots": 2 },
  "stop_gate": { "require_clean_tree": true, "max_blocks": 5 },
  "merge": { "method": "squash", "delete_branch": true }
}
