{
  "base_branch": "main",
  "remote": "origin",
  "fast_check": "",
  "checks": [
    "test -s bricks.html",
    "head -c 15 bricks.html | tr -d '\\0' | grep -qi '<!doctype html>'",
    "grep -q 'requestAnimationFrame' bricks.html",
    "grep -qE 'class=\"game\"|id=\"game\"|<canvas' bricks.html",
    "grep -qi 'monospace' bricks.html",
    "[ \"$(grep -E '(src|href)=' bricks.html | grep -v 'href=\"index.html\"' | wc -l)\" -eq 0 ]",
    "[ \"$(grep -E '(src|href)=' asteroids.html | grep -v 'href=\"index.html\"' | wc -l)\" -eq 0 ]",
    "grep -q 'href=\"bricks.html\"' index.html && grep -q 'href=\"asteroids.html\"' index.html && [ \"$(grep -c '<script' index.html)\" -eq 0 ]",
    "test -x scripts/package-oneshot.sh",
    "grep -qE '^[[:space:]]*#game[[:space:]]*\\{[^}]*cursor:[[:space:]]*none' bricks.html",
    "[ \"$(grep 'data-difficulty=' bricks.html | grep -c selected)\" -eq 1 ] && grep 'data-difficulty=\"normal\"' bricks.html | grep -q selected",
    "[ \"$(grep 'data-mode=' bricks.html | grep -c selected)\" -eq 1 ] && grep 'data-mode=\"classic\"' bricks.html | grep -q selected",
    "grep -q 'id=\"btn-mute\"' bricks.html && grep -q 'id=\"sound-volume\"' bricks.html",
    "grep -q 'id=\"leaderboard-start\"' bricks.html && grep -q 'id=\"btn-reset-hiscore\"' bricks.html",
    "grep -q 'ENGINE_FLAME_MIN_PX' asteroids.html",
    "grep -q 'ASTEROID_R_LARGE' asteroids.html",
    "grep -q 'toggleFullscreen' bricks.html",
    "grep -q 'toggleFullscreen' asteroids.html",
    "test -f Dockerfile && grep -q 'caddy:latest' Dockerfile",
    "grep -q 'COPY index.html bricks.html asteroids.html' Dockerfile",
    "grep -q 'ghcr.io/wentbackward/oneshot' .github/workflows/deploy.yml",
    "for f in tests/*.test.mjs; do timeout 60 node \"$f\" || exit 1; done"
  ],
  "heavy": { "slots": 2 },
  "stop_gate": { "require_clean_tree": true, "max_blocks": 5 },
  "merge": { "method": "squash", "delete_branch": true }
}
